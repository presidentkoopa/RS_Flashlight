OptionMenu "RSFLDust"
{
	Title "Dust"
	StaticText "Motes hanging in the beam. Sampled in world", "gray"
	StaticText "space, so they stay put in the room -- sweeping", "gray"
	StaticText "the torch reveals different dust rather than", "gray"
	StaticText "dragging the same motes around with you.", "gray"
	StaticText ""
	Slider "How much", "rsfl_dust", 0.0, 1.0, 0.05, 2
	Slider "How fine", "rsfl_dust_scale", 0.005, 0.12, 0.005, 3
