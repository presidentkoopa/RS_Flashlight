// menu_lint (tools\menu_lint.py) holds the tuning pages to the live-slider
// rule: every slider on them has to move the torch while the menu is open --
// RSFL_Handler.Publish, run from UiTick, for the cone, and the net-event relay
// beside SyncUnderMenu for the spot. See the LINT-UI-LIVE lines there.
// LINT-LIVE: RSFLMain RSFLBeam RSFLDust RSFLColor
//
// The two SEEN END-ON rows are the ENGINE's cvars, not this mod's. The
// renderer reads them itself every frame (hw_drawinfo.cpp, the volumetric beam
// uniforms), so they are as live as a slider gets -- but no push in this mod
// can vouch for them, so they are named here instead.
// LINT-LIVE-OK: vol_beam_axisfade vol_beam_axisfade_reach

OptionValue "RSFL_Mount"
{
	0, "On your head"
	1, "Off hand"
	2, "Weapon hand"
}

OptionMenu "RSFLMain"
{
	Title "Flashlight"
	StaticText "A cone of lit air, not just a bright patch on", "gray"
	StaticText "the wall. Press F to switch it on.", "gray"
	StaticText ""
	Option "Enabled", "rsfl_enabled", "OnOff"
	Option "Mounted", "rsfl_mount", "RSFL_Mount"
	StaticText "The off hand is the one worth having in VR --", "gray"
	StaticText "you can light a doorway while aiming somewhere", "gray"
	StaticText "else. Head-mounted always points where you are", "gray"
	StaticText "already looking, and a cone seen end-on is just", "gray"
	StaticText "a disc.", "gray"
	StaticText ""
	Slider "Lens forward", "rsfl_offset_fwd", -32.0, 32.0, 1.0, 0
	Slider "Lens right", "rsfl_offset_side", -32.0, 32.0, 1.0, 0
	Slider "Lens up", "rsfl_offset_z", -32.0, 32.0, 1.0, 0
	StaticText "Measured along the hand or head, so they turn", "gray"
	StaticText "with it. Moving it off the aim axis stops it", "gray"
	StaticText "washing out the middle of the frame.", "gray"
	StaticText ""
	Submenu "The Beam", "RSFLBeam"
	Submenu "Dust", "RSFLDust"
	Submenu "Colour", "RSFLColor"
}

OptionMenu "RSFLBeam"
{
	Title "The Beam"
	Slider "Hot core (degrees)", "rsfl_inner", 1.0, 60.0, 1.0, 0
	Slider "Faded out by (degrees)", "rsfl_outer", 2.0, 80.0, 1.0, 0
	StaticText "The core never grows past the fade.", "gray"
	Slider "Reach", "rsfl_length", 128.0, 4096.0, 64.0, 0
	Slider "Brightness", "rsfl_density", 0.0, 2.0, 0.05, 2
	StaticText ""
	Slider "Falloff", "rsfl_falloff", 0.5, 4.0, 0.1, 1
	StaticText "Above 1 concentrates the light near the lens,", "gray"
	StaticText "which stops a long beam looking like a strip", "gray"
	StaticText "light.", "gray"
	StaticText ""
	Slider "Lights what it hits", "rsfl_spot", 0.0, 2.0, 0.05, 2
	StaticText "0 is no light on the walls at all, just the cone.", "gray"
	Option "  Walls block it", "rsfl_spot_shadows", "OnOff"
	StaticText "Off, it shines through walls into the next room.", "gray"
	StaticText ""
	Slider "Flicker", "rsfl_flicker", 0.0, 0.5, 0.01, 2
	StaticText "A little unsteadiness is most of what stops it", "gray"
	StaticText "reading as a cone bolted to your face.", "gray"
	StaticText ""
	StaticText "SEEN END-ON -- every cone, not just this one", "white"
	Slider "Fade", "vol_beam_axisfade", 0.0, 1.0, 0.05, 2
	Slider "  when it passes this close to your eye", "vol_beam_axisfade_reach", 0.0, 64.0, 1.0, 0
	StaticText "A cone pointed straight where you look is a disc", "gray"
	StaticText "over the middle of the view. This fades it, but", "gray"
	StaticText "only when the beam starts near your eye -- a torch", "gray"
	StaticText "held in a hand keeps its light.", "gray"
}

OptionMenu "RSFLDust"
{
	Title "Dust"
	StaticText "Motes hanging in the beam. Sampled in world", "gray"
	StaticText "space, so they stay put in the room -- sweeping", "gray"
	StaticText "the torch reveals different dust rather than", "gray"
	StaticText "dragging the same motes around with you.", "gray"
	StaticText ""
	Slider "How much", "rsfl_dust", 0.0, 1.0, 0.05, 2
	Slider "How fine", "rsfl_dust_scale", 0.005, 0.12, 0.005, 3
	Slider "How fast it settles", "rsfl_dust_drift", 0.0, 40.0, 0.25, 2
	StaticText "Units a second. Under about 5 the dust hangs", "gray"
	StaticText "still; drifting starts showing above that.", "gray"
}

OptionMenu "RSFLColor"
{
	Title "Colour"
	Slider "Red", "rsfl_r", 0, 255, 5, 0
	Slider "Green", "rsfl_g", 0, 255, 5, 0
	Slider "Blue", "rsfl_b", 0, 255, 5, 0
	StaticText ""
	StaticText "It also lights the fog, if RS_Fog is loaded --", "gray"
	StaticText "the mist takes the torch's colour, brightness", "gray"
	StaticText "and falloff where the cone passes through it.", "gray"
}

// WITHOUT THIS THE MENU ABOVE EXISTS AND IS UNREACHABLE. Defining an
// OptionMenu only names it; nothing in the game links to it until something
// adds a Submenu entry pointing at it. Same hook RS_Darkness and
// RS_GlowInTheDark use, which is why theirs showed up and this one did not.
AddOptionMenu "OptionsMenu"
{
	Submenu "Flashlight", "RSFLMain"
}
